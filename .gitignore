# Чувствительные данные (реальные заказы, ФИО клиентов, телефоны)
# — любое содержимое samples/ не должно попадать в репозиторий
samples/
out/

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Системные файлы macOS
.DS_Store

# Тесты
.pytest_cache/

# Локальные БД учёта.
# Спутники SQLite названы отдельно намеренно: `*.db` их НЕ покрывает, а
# `prod.db-journal` содержит образы страниц базы — то есть те же ФИО
# клиентов и исполнителей, что и сама база. Найден непокрытым 26.09.2026
# (CF-435): файл висел в `git status` как неотслеживаемый.
*.db
*.db-journal
*.db-wal
*.db-shm

# Тестовый стенд: собирается make_test_stand.py, в репозиторий не кладётся
teststand/

# TLS-сертификаты пилота (генерируются локально)
certs/
*.pem
